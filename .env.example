# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web

# PostgreSQL (local dev)
DB_NAME=taskflow_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Redis (local: host localhost:6379; leave username/password empty for Docker Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=

# Docker Compose (used in docker-compose.yml for Postgres service)
POSTGRES_PASSWORD=change-me
